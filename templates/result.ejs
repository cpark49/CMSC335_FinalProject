<!DOCTYPE html>

<html>

<head>

    <title>Mood Result</title>
    <link rel="stylesheet" href="/styles.css">

</head>

<body>

    <div class="container">

        <h1>
            Your Mood: <%= mood %>
        </h1>

        <p class="message">
            <%= message %>
        </p>

        <% if (isVideo) { %>

            <video
                class="dog-media"
                src="<%= dogUrl %>"
                controls
                autoplay
                muted
                loop
                playsinline>
            </video>

        <% } else { %>

            <img
                class="dog-media"
                src="<%= dogUrl %>"
                alt="Random Dog">

        <% } %>

        <br>
        <br>

        <div class="summary-box">

            <h2>Mood Statistics</h2>

            <p>
                Total mood submissions:
                <strong><%= totalMoods %></strong>
            </p>

            <p>
                Most common mood:
                <strong><%= mostCommonMood %></strong>
            </p>

        </div>

        <br>
        <br>

        <a href="/">
            Return Home
        </a>

    </div>

</body>

</html>